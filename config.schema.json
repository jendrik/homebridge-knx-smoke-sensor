{
  "pluginAlias": "knx-smoke-sensor",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "ip": {
        "title": "KNX Router or Interface",
        "type": "string",
        "default": "224.0.23.12",
        "placeholder": "224.0.23.12",
        "description": "IP address of the KNX router or interface."
      },
      "port": {
        "title": "KNX Port",
        "type": "integer",
        "default": 3671,
        "minimum": 1,
        "maximum": 65535,
        "description": "KNXnet/IP port."
      },
      "devices": {
        "type": "array",
        "minItems": 1,
        "items": {
          "title": "Smoke Sensors",
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true,
              "placeholder": "Display Name for Smoke Sensor"
            },
            "listen_smoke_detected": {
              "title": "Smoke Detected",
              "type": "string",
              "required": true,
              "placeholder": "1/1/1",
              "pattern": "^[0-9]{1,4}/[0-9]{1,4}/[0-9]{1,4}$"
            },
            "listen_status_fault": {
              "title": "Status Fault",
              "type": "string",
              "required": false,
              "placeholder": "1/1/1",
              "pattern": "^[0-9]{1,4}/[0-9]{1,4}/[0-9]{1,4}$"
            },
            "listen_status_tampered": {
              "title": "Status Tampered",
              "type": "string",
              "required": false,
              "placeholder": "1/1/1",
              "pattern": "^[0-9]{1,4}/[0-9]{1,4}/[0-9]{1,4}$"
            },
            "listen_low_battery": {
              "title": "Status Low Battery",
              "type": "string",
              "required": false,
              "placeholder": "1/1/1",
              "pattern": "^[0-9]{1,4}/[0-9]{1,4}/[0-9]{1,4}$"
            }
          },
          "required": [
            "name",
            "listen_smoke_detected"
          ]
        }
      }
    },
    "required": [
      "devices"
    ]
  },
  "layout": [
    {
      "key": "devices",
      "type": "array",
      "orderable": false,
      "buttonText": "Add Smoke Sensor",
      "items": [
        "devices[].name",
        "devices[].listen_smoke_detected",
        "devices[].listen_status_fault",
        "devices[].listen_status_tampered",
        "devices[].listen_low_battery"
      ]
    },
    {
      "type": "section",
      "title": "Global",
      "expandable": true,
      "expanded": false,
      "items": [
        "ip",
        "port"
      ]
    }
  ]
}
