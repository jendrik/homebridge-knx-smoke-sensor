{
  "displayName": "KNX Smoke Sensor",
  "name": "@jendrik/homebridge-knx-smoke-sensor",
  "type": "module",
  "version": "2.0.0",
  "description": "Homebridge plugin for KNX Smoke Sensors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/jendrik/homebridge-knx-smoke-sensor.git"
  },
  "bugs": {
    "url": "https://github.com/jendrik/homebridge-knx-smoke-sensor/issues"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "homebridge": "^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run lint && npm test",
    "watch": "npm run build && npm link && nodemon"
  },
  "keywords": [
    "homebridge-plugin",
    "knx"
  ],
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "homebridge": "^2.0.2",
    "nodemon": "^3",
    "rimraf": "^6",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "dependencies": {
    "knx": "^2.5.4"
  }
}
